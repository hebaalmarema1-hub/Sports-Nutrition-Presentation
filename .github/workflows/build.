name: Build PowerPoint Presentation

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Get repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        run: npm install

      - name: Generate PowerPoint
        run: npm run build

      - name: Upload PowerPoint
        uses: actions/upload-artifact@v4
        with:
          name: Sports-Nutrition-Presentation
          path: Sports-Nutrition.pptx
